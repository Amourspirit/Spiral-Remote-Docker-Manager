# You can use OpenSSL in your terminal to generate the secrets
# echo "      - ARCANE_ENCRYPTION_KEY=$(openssl rand -hex 32)"
# echo "      - ARCANE_JWT_SECRET=$(openssl rand -hex 32)"
SERVER_TZ="America/Toronto"
COMPOSE_PROJECT_NAME="arcane-docker-manager"
ARCANE_ENCRYPTION_KEY=58eb7dac10ff6214258ad50bb4f4bbfbe5285e3965b1a44cc79a0e115d1c7388
ARCANE_JWT_SECRET=c232eca2d12140508b1b76a152c4ce6d4b7c09d7b596035cbd81f911a20a4eda
ARCANE_PUID=1000
ARCANE_PGID=1000
ARCANE_EXTERNAL_PORT=3552
ARCANE_STORAGE_PATH=./storage/arcane
ARCANE_APP_URL_PUBLIC=https://arcane.example.com/

DOCKER_SOCKS_PATH=/var/run/docker.sock

# Cloudflare Tunnel configuration
CF_TUNNEL_ID="<CloudFlare Tunnel ID>"
CF_TUNNEL_TOKEN="<CloudFlare Tunnel Token>"
CF_ZONE_ID="<CloudFlare Zone ID>"
CF_API_TOKEN="<CloudFlare API Token>"
CF_CONNECT_TIMEOUT=5
CF_MAX_TIME=8
CF_RETRY_COUNT=3
# comma-separated list of record names to create/update in the zone. Use a single record name for a single tunnel, or multiple record names for multiple tunnels.
CF_RECORD_NAMES=arcane.example.com
CF_TUNNEL_CNAME="${CF_TUNNEL_ID}.cfargotunnel.com"
CF_ALLOW_DELETE_MISMATCH=false # Set to true to allow delete when CNAME target differs.
CF_ROUTE_ENABLE_ON_START=1
CF_ROUTE_DISABLE_ON_STOP=1